# Search run state and per-partition output are kept locally; the compressed
# verification archive and final summaries are versionable.
/data/*
!/data/final-report.json
!/data/final-report.md
!/data/primes.txt
!/data/coverage-artifacts.tar.gz
/data-small/
/data-smoke/
/data-smoke2/
/data-smoke3/
/target/
__pycache__/
*.py[cod]
/.runtime/

jj-build-path-check/
# Keep restart-critical BigUint state in jj: the durable checkpoint,
# completed partition records/manifests, and the 2–128 comparison result.
/data-bigint/*
!/data-bigint/checkpoint.json
!/data-bigint/big-b*.jsonl
!/data-bigint/manifest-b*.json
!/data-bigint/comparison-2-128.json
!/data-bigint/final-report.md
